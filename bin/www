
#!/usr/bin/env node

// LECTURE: MEAN Stack Development, slides 59-60.
// Topic: Creating an HTTP server and listening on port 3000.

// LECTURE: MEAN Stack Development, slides 44-47.
// Topic: Loading modules using require().

// Import the Express application from app.js.
const app = require('../app');

// Import Node.js built-in HTTP module.
const http = require('http');

// Use the cloud hosting port or port 3000 locally.
const port = process.env.PORT || 3000;

// Create the HTTP server using the Express application.
const server = http.createServer(app);

// Start listening for incoming requests.
server.listen(port, function () {
  console.log('Portfolio running at http://localhost:' + port);
});
