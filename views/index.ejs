<%# LECTURE: MEAN Stack Development, slides 98, 103-104 (EJS templates). %>

<%- include('partials/header') %>
<main>
  <section class="hero">
    <div class="page-width">
      <p class="eyebrow">
        INFORMATION TECHNOLOGY · NETWORKING · DIGITAL CREATIVITY
      </p>
      <h1>
        Hi, I'm
        <span>
          Thmisha Rasanathan.
        </span>
      </h1>
      <p class="hero-intro">
        I'm studying Networking and IT Security at Ontario Tech University. I combine technical curiosity with experience in digital content, communication and client-facing operations.
      </p>
      <div class="d-flex flex-wrap gap-3 mt-4">
        <a class="button" href="/projects">
          <i class="fa-solid fa-folder-open me-2">
          </i>
          Explore my work
        </a>
        <a class="button button-outline" href="/contact">
          Contact me
        </a>
      </div>
    </div>
  </section>
  <section class="page-width content-section">
    <h2>
      What I do
    </h2>
    <!-- THIRD PARTY: Bootstrap responsive grid and Font Awesome icons. -->
    <div class="row g-4">
      <%# LECTURE: Chapter 10, slides 3-4 (forEach to iterate an array of objects). %>
      <%# PROJECT IMPLEMENTATION: each object defines a skill card; EJS prints its values. %>
      <% [{icon:'fa-shield-halved',title:'Cybersecurity & Technology',copy:'Developing skills in networking, IT security and programming through academic projects and hands-on learning.'},{icon:'fa-pen-nib',title:'Digital Marketing & Design',copy:'Creating digital campaigns, social media content and promotional materials for cybersecurity and healthcare organizations.'},{icon:'fa-calendar-check',title:'Project & Event Coordination',copy:'Supporting events, conferences and collaborative projects with organization, communication and teamwork.'}].forEach(function(card) { %>
        <div class="col-md-4">
          <article class="tile h-100 w-100 m-0">
            <i class="fa-solid <%= card.icon %> fa-xl mb-3" aria-hidden="true">
            </i>
            <h3>
              <%= card.title %>
            </h3>
            <p>
              <%= card.copy %>
            </p>
          </article>
        </div>
      <% }); %>
    </div>
  </section>
  <section class="page-width content-section soft-panel">
    <h2>
      Take a look around
    </h2>
    <p>
      Explore my background, projects and ways to connect.
    </p>
    <a class="text-link me-4" href="/about">
      About me →
    </a>
    <a class="text-link" href="/projects">
      Projects →
    </a>
  </section>
</main>
<%- include('partials/footer') %>