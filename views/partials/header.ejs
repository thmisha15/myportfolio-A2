<%# LECTURE: MEAN Stack Development, slides 98, 103-104 (EJS views). %>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Portfolio of Thmisha Rasanathan — networking, IT security and digital marketing.">
    <title>
      <%= title %> | Thmisha Rasanathan
    </title>
    <!-- ASSIGNMENT REQUIREMENT / THIRD PARTY: Bootstrap v5.3.3 CDN; not shown in supplied slides. -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- ASSIGNMENT REQUIREMENT / THIRD PARTY: Font Awesome v6.7.2 icons. -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet">
    <!-- LECTURE: MEAN Stack Development, slides 106-109 (assets from public/). -->
    <!-- PROJECT IMPLEMENTATION: responsive styles were adapted from my portfolio. -->
    <link rel="stylesheet" href="/css/styles-laptop.css">
    <link rel="stylesheet" href="/css/styles-tablet.css" media="(min-width:601px) and (max-width:1023px)">
    <link rel="stylesheet" href="/css/styles-mobile.css" media="(max-width:600px)">
    <link rel="stylesheet" href="/css/express-enhancements.css">
  </head>
  <body>
    <!-- PROJECT IMPLEMENTATION / BOOTSTRAP: responsive navbar shared across pages. -->
    <header class="site-header">
      <nav class="navbar navbar-expand-md navbar-dark page-width" aria-label="Main navigation">
        <a class="navbar-brand fw-bold" href="/">
          Thmisha
          <span class="brand-accent">
            R.
          </span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#siteNav" aria-controls="siteNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon">
          </span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="siteNav">
          <ul class="navbar-nav gap-md-3">
            <%# LECTURE: Chapter 10, slides 3-4 (Array.forEach); MEAN Stack, slide 104 (EJS tags). %>
            <%# PROJECT IMPLEMENTATION: loop prints four navigation links and marks the current page. %>
            <% [['home','/','Home'],['about','/about','About'],['projects','/projects','Projects'],['contact','/contact','Contact']].forEach(function(item) { %>
              <li class="nav-item">
                <a class="nav-link <%= active === item[0] ? 'active' : '' %>" <%- active === item[0] ? 'aria-current="page"' : '' %> href="<%= item[1] %>">
                  <%= item[2] %>
                </a>
              </li>
            <% }); %>
          </ul>
        </div>
      </nav>
    </header>
